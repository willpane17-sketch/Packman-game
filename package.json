{
  "name": "burger-munch",
  "productName": "Burger Munch",
  "version": "1.0.0",
  "description": "A Pac-Man style arcade game set in Fortnite locations",
  "main": "main.js",
  "author": "willpane17-sketch",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --publish never",
    "build:installer": "electron-builder --win nsis --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.willpane17.burgermunch",
    "productName": "Burger Munch",
    "files": [
      "main.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "fonts/**/*"
    ],
    "directories": { "output": "dist" },
    "win": { "target": ["portable"], "icon": "assets/icon.png" },
    "mac": { "target": ["dmg"], "icon": "assets/icon.png", "category": "public.app-category.games" },
    "linux": { "target": ["AppImage"], "icon": "assets/icon.png", "category": "Game" }
  }
}
